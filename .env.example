# Copy to .env and fill in. Never commit .env.

# Anthropic — script generation (https://platform.claude.com)
ANTHROPIC_API_KEY=sk-ant-...

# ElevenLabs — voiceover (https://elevenlabs.io -> Profile -> API key)
ELEVENLABS_API_KEY=...

# Optional: YouTube upload. Path to the OAuth client secrets JSON downloaded
# from Google Cloud Console (Desktop app credentials, YouTube Data API v3 enabled).
YOUTUBE_CLIENT_SECRETS=client_secrets.json
