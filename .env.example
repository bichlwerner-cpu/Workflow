# ============================================================
# yt-automation config
# ============================================================
# Default workflow is FREE: a procedural stickman animation with
# either Microsoft edge-tts (online, natural) or espeak-ng (fully
# offline) narration, and curated/template psychology scripts.
# Paid upgrades (Claude scripts, ElevenLabs voice) are optional.
# ============================================================

# --- TTS (voice) ----------------------------------------------
# edge       = Microsoft Edge voices, free, online, natural-sounding
# local      = espeak-ng, free, FULLY OFFLINE, robotic (needs `espeak-ng`)
# elevenlabs = ElevenLabs, paid, best quality
TTS_PROVIDER=edge

# Edge voice. List with `yt-automation voices --language en`
# Good psychology-channel voices: en-US-AndrewMultilingualNeural,
# en-US-BrianMultilingualNeural, en-US-AvaMultilingualNeural
EDGE_VOICE=en-US-AndrewMultilingualNeural

# Offline espeak-ng voice + speed (only used when TTS_PROVIDER=local)
LOCAL_VOICE=en-us
LOCAL_RATE=165

# --- Captions (optional, only for the legacy footage workflow) ---
# tiny | base | small | medium | large-v3
WHISPER_MODEL=base

# --- Output / Assets ------------------------------------------
OUTPUT_DIR=./out
MUSIC_DIR=./assets/music
FOOTAGE_DIR=./assets/footage

# ============================================================
# Optional paid APIs (leave blank to stay on the free path)
# ============================================================

# Anthropic (Claude) -- writes fresh, high-quality scripts.
# Without a key, curated + template scripts are used (still good, offline).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-7
ANTHROPIC_EFFORT=high

# ElevenLabs -- only when TTS_PROVIDER=elevenlabs
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
