# ============================================================
# yt-automation config
# ============================================================
# Default: kostenloser Workflow (edge-tts, Skript schreibst du
# selbst in skript.txt). Bezahl-Optionen unten -- nur ausfuellen
# falls du sie wirklich nutzen willst.
# ============================================================

# --- TTS (Stimme) ---------------------------------------------
# edge       = Microsoft Edge Stimmen, kostenlos, kein Key
# elevenlabs = ElevenLabs (besser, aber begrenztes Gratis-Kontingent)
TTS_PROVIDER=edge

# Edge-Stimme. Liste mit `yt-automation voices --language de`
EDGE_VOICE=de-DE-KatjaNeural

# --- Whisper (Untertitel) -------------------------------------
# tiny | base | small | medium | large-v3
# base reicht. small ist genauer, dauert laenger.
WHISPER_MODEL=base

# --- Output / Assets ------------------------------------------
OUTPUT_DIR=./out
MUSIC_DIR=./assets/music
FOOTAGE_DIR=./assets/footage

# ============================================================
# Optional: Bezahl-APIs (nur ausfuellen wenn benutzt)
# ============================================================

# Anthropic (Claude) -- nur fuer `yt-automation script` und `run`
# (nicht noetig fuer `yt-automation from-text ...`)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-7
ANTHROPIC_EFFORT=high

# ElevenLabs -- nur wenn TTS_PROVIDER=elevenlabs
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# ============================================================
# Scene-Pack-Extraktion
# ============================================================
# Empfindlichkeit der Szenen-Erkennung (PySceneDetect).
# Niedriger = mehr Schnitte erkannt. 27 ist ein guter Default.
SCENE_THRESHOLD=27
# Min/Max-Laenge eines extrahierten Clips (Sekunden)
SCENE_MIN_LEN=2.0
SCENE_MAX_LEN=6.0

# ============================================================
# YouTube-Upload (optional)
# ============================================================
# Pfad zur OAuth-Client-Datei aus der Google Cloud Console.
# Type: "Desktop app", YouTube Data API v3 muss aktiviert sein.
# Wenn leer, ueberspringt die Pipeline den Upload-Schritt.
YT_CLIENT_SECRET=./secrets/client_secret.json
# Token-Cache (wird nach erstem Login automatisch befuellt)
YT_TOKEN_CACHE=./secrets/token.json
# private | unlisted | public
YT_DEFAULT_PRIVACY=private
# 24=Entertainment, 22=People&Blogs, 23=Comedy, 27=Education
YT_DEFAULT_CATEGORY=24
# Default-Sprache des Uploads (BCP-47)
YT_DEFAULT_LANGUAGE=de
