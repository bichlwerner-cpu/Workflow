# ============================================================
# yt-automation config
# ============================================================
# Default: kostenloser Workflow (edge-tts, Skript schreibst du
# selbst in skript.txt). Bezahl-Optionen unten -- nur ausfuellen
# falls du sie wirklich nutzen willst.
# ============================================================

# --- TTS (Stimme) ---------------------------------------------
# edge       = Microsoft Edge Stimmen, kostenlos, kein Key
# elevenlabs = ElevenLabs (besser, aber begrenztes Gratis-Kontingent)
TTS_PROVIDER=edge

# Edge-Stimme. Liste mit `yt-automation voices --language de`
EDGE_VOICE=de-DE-KatjaNeural

# --- Whisper (Untertitel) -------------------------------------
# tiny | base | small | medium | large-v3
# base reicht. small ist genauer, dauert laenger.
WHISPER_MODEL=base

# --- Output / Assets ------------------------------------------
OUTPUT_DIR=./out
MUSIC_DIR=./assets/music
FOOTAGE_DIR=./assets/footage

# --- Mascot (2D Brand-Charakter) ------------------------------
# Farbe: sunny | teal | blue | purple | coral
# Accessoire: glasses  (leer lassen fuer keins)
MASCOT_PALETTE=purple
MASCOT_ACCESSORY=glasses

# ============================================================
# Optional: Bezahl-APIs (nur ausfuellen wenn benutzt)
# ============================================================

# --- Skript-Generator -----------------------------------------
# Wer schreibt das Skript bei `yt-automation script` / `run`?
# claude = Anthropic   |   gemini = Google Gemini
# (nicht noetig fuer `yt-automation from-text ...`)
SCRIPT_PROVIDER=gemini

# Google Gemini -- Skript (Text) UND Bildgenerierung nutzen denselben Key.
GEMINI_API_KEY=
# Text-Modell (Skript) -- nur wenn SCRIPT_PROVIDER=gemini
GEMINI_MODEL=gemini-2.5-flash
# Bild-Modell (Nano Banana) fuer `mascot gen` / `gen-set`.
# Pro: gemini-3-pro-image-preview  |  guenstiger/schneller: gemini-2.5-flash-image
GEMINI_IMAGE_MODEL=gemini-3-pro-image-preview

# Anthropic (Claude) -- nur wenn SCRIPT_PROVIDER=claude
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-7
ANTHROPIC_EFFORT=high

# ElevenLabs -- nur wenn TTS_PROVIDER=elevenlabs
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
