# Copy to .env and fill in. Never commit .env.

# Script generation — fill in the key for the provider set in
# config/settings.yaml (llm.provider). Default is gemini (free).

# Google Gemini, FREE key from https://aistudio.google.com/apikey
GEMINI_API_KEY=...

# Anthropic (paid alternative, https://platform.claude.com) — only needed
# if llm.provider is set to claude.
# ANTHROPIC_API_KEY=sk-ant-...

# ElevenLabs — voiceover (https://elevenlabs.io -> Profile -> API key)
ELEVENLABS_API_KEY=...

# Optional: YouTube upload. Path to the OAuth client secrets JSON downloaded
# from Google Cloud Console (Desktop app credentials, YouTube Data API v3 enabled).
YOUTUBE_CLIENT_SECRETS=client_secrets.json
